# Public Firebase web app configuration (not Admin credentials).
# Vite reads the ROOT environment files because envDir points there.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_GEMINI_TIMEOUT_MS=25000

# Server only: add these to root .env.local and Vercel environment settings.
# Never prefix credentials with VITE_.
GEMINI_API_KEY=
GEMINI_GENERATE_MODEL=gemini-2.5-flash-lite
# One-line JSON service account, enclosed in single quotes; preserve escaped newlines.
FIREBASE_SERVICE_ACCOUNT_JSON=
