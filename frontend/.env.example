# Reference only: set these in root .env.local, not frontend/.env.local.
# Public Firebase web app configuration (not Admin credentials).
# Vite reads the ROOT environment files because envDir points there.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_GEMINI_TIMEOUT_MS=25000
