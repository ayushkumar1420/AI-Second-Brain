rules_version = '2';

service cloud.firestore{
  match /databases/{database}/documents{

    function signedIn(){
      return request.auth != null;
    }

    function ownsExisting(){
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncoming(){
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function allowedCollection(collection){
      return collection in ["notes", "documents", "links", "chats", "activities"];
    }

    match /users/{userId}{
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /{collection}/{documentId}{
      allow read: if allowedCollection(collection) && ownsExisting();

      allow create: if allowedCollection(collection) && ownsIncoming();

      allow update: if allowedCollection(collection)
                    && ownsExisting()
                    && ownsIncoming();

      allow delete: if allowedCollection(collection) && ownsExisting();
    }
  }
}
