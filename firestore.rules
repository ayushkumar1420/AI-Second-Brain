rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncoming() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /{collection}/{documentId} {
      allow read, update, delete: if collection in ["notes", "documents", "links", "chats", "activities"] && ownsExisting();
      allow create: if collection in ["notes", "documents", "links", "chats", "activities"] && ownsIncoming();
    }
  }
}
